{
  "name": "gtourjs",
  "version": "1.2.0",
  "description": "A lightweight JavaScript library for creating beautiful feature tours and onboarding experiences",
  "main": "dist/gtour.min.js",
  "module": "dist/gtour.esm.mjs",
  "style": "dist/gtour.min.css",
  "exports": {
    ".": {
      "import": "./dist/gtour.esm.mjs",
      "require": "./dist/gtour.min.js",
      "default": "./dist/gtour.min.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist/gtour.js",
    "dist/gtour.min.js",
    "dist/gtour.esm.mjs",
    "dist/gtour.css",
    "dist/gtour.min.css",
    "dist/icon/"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "tour",
    "guide",
    "onboarding",
    "feature-tour",
    "product-tour",
    "tutorial",
    "walkthrough",
    "javascript",
    "vanilla-js",
    "tooltip",
    "spotlight",
    "user-guide"
  ],
  "author": "Gigih Hadi Prakoso",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gigihhadiprakoso/gtourjs.git"
  },
  "bugs": {
    "url": "https://github.com/gigihhadiprakoso/gtourjs/issues"
  },
  "homepage": "https://github.com/gigihhadiprakoso/gtourjs#readme",
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "dependencies": {}
}
